<?xml version="1.0"?>
<!--
  Standalone base-plate-with-hole model (peghole workcell only): spawned
  separately from the robot URDF, rather than welded into it with a fixed
  joint, so its world position can be changed by editing the spawn
  `-x`/`-y`/`-z` args in the launch file -- no xacro edit or colcon rebuild
  needed to reposition it.

  <static>true</static>: it rests in the assembly fixture, not a pickable
  part.

  Geometry matches the `base_plate_with_hole` xacro macro in
  assembly_objects.urdf.xacro: a real mesh (meshes/base_plate_with_hole
  .stl, generated by meshes/generate_plate_with_hole.py), 0.10 x 0.07 x
  0.006 m with a genuine 0.012 m hole radius. Link origin is at the
  plate's bottom face center.

  Mass/inertia carried over unchanged from the original macro (mass =
  0.05 kg, inertial pose z = 0.003) -- inert either way since the model
  is static.
-->
<sdf version="1.9">
  <model name="base_plate">
    <static>true</static>
    <link name="base_plate_link">
      <inertial>
        <pose>0 0 0.003 0 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>5e-6</ixx>
          <iyy>5e-6</iyy>
          <izz>1e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <mesh><uri>package://so101_description/meshes/base_plate_with_hole.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.78 1.0</ambient>
          <diffuse>0.75 0.75 0.78 1.0</diffuse>
          <specular>0.7 0.7 0.7 1.0</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh><uri>package://so101_description/meshes/base_plate_with_hole.stl</uri></mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
