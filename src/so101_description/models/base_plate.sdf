<?xml version="1.0"?>
<!--
  Base plate with a hole: 100 x 70 x 6 mm, hole radius 12 mm (mesh made by
  meshes/generate_plate_with_hole.py). Static. Origin at the bottom face centre.
-->
<sdf version="1.9">
  <model name="base_plate">
    <!-- Ground-truth label for the segmentation camera. Unique per object type. -->
    <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
      <label>4</label>
    </plugin>
    <static>true</static>
    <link name="base_plate_link">
      <inertial>
        <pose>0 0 0.003 0 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>5e-6</ixx>
          <iyy>5e-6</iyy>
          <izz>1e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <mesh><uri>package://so101_description/meshes/base_plate_with_hole.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.78 1.0</ambient>
          <diffuse>0.75 0.75 0.78 1.0</diffuse>
          <specular>0.7 0.7 0.7 1.0</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh><uri>package://so101_description/meshes/base_plate_with_hole.stl</uri></mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
