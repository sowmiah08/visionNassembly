<?xml version="1.0"?>
<!--
  4-pin plug: a free body the gripper can pick up. 50 x 50 mm body, four
  pins (radius 5 mm, 20 mm long) and a knob on top. Origin at the pin tips.
  Mass and inertia are computed for solid PLA (0.065 kg, centre of mass
  z = 0.0298). Friction 1.0 so it doesn't slip in the gripper.
-->
<sdf version="1.9">
  <model name="plug">
    <!-- Ground-truth segmentation label (see segmentation_camera in
         dual_arm_workcell_gazebo.urdf.xacro). Unique per object type. -->
    <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
      <label>1</label>
    </plugin>
    <link name="plug_link">
      <inertial>
        <pose>0 0 0.02982 0 0 0</pose>
        <mass>0.06492</mass>
        <inertia>
          <ixx>2.0305e-05</ixx>
          <iyy>2.0305e-05</iyy>
          <izz>2.0762e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Body (aluminum) -->
      <visual name="body_visual">
        <pose>0 0 0.026 0 0 0</pose>
        <geometry>
          <box><size>0.05 0.05 0.012</size></box>
        </geometry>
        <material>
          <ambient>0.85 0.42 0.10 1.0</ambient>
          <diffuse>0.85 0.42 0.10 1.0</diffuse>
          <specular>0.7 0.7 0.7 1.0</specular>
        </material>
      </visual>
      <collision name="body_collision">
        <pose>0 0 0.026 0 0 0</pose>
        <geometry>
          <box><size>0.05 0.05 0.012</size></box>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>

      <!-- 4 pins in a 2x2 pattern (steel) -->
      <visual name="pin_pp_visual">
        <pose>0.015 0.015 0.01 0 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.02</length></cylinder></geometry>
        <material>
          <ambient>0.55 0.57 0.60 1.0</ambient>
          <diffuse>0.55 0.57 0.60 1.0</diffuse>
        </material>
      </visual>
      <collision name="pin_pp_collision">
        <pose>0.015 0.015 0.01 0 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.02</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>

      <visual name="pin_pn_visual">
        <pose>0.015 -0.015 0.01 0 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.02</length></cylinder></geometry>
        <material>
          <ambient>0.55 0.57 0.60 1.0</ambient>
          <diffuse>0.55 0.57 0.60 1.0</diffuse>
        </material>
      </visual>
      <collision name="pin_pn_collision">
        <pose>0.015 -0.015 0.01 0 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.02</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>

      <visual name="pin_np_visual">
        <pose>-0.015 0.015 0.01 0 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.02</length></cylinder></geometry>
        <material>
          <ambient>0.55 0.57 0.60 1.0</ambient>
          <diffuse>0.55 0.57 0.60 1.0</diffuse>
        </material>
      </visual>
      <collision name="pin_np_collision">
        <pose>-0.015 0.015 0.01 0 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.02</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>

      <visual name="pin_nn_visual">
        <pose>-0.015 -0.015 0.01 0 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.02</length></cylinder></geometry>
        <material>
          <ambient>0.55 0.57 0.60 1.0</ambient>
          <diffuse>0.55 0.57 0.60 1.0</diffuse>
        </material>
      </visual>
      <collision name="pin_nn_collision">
        <pose>-0.015 -0.015 0.01 0 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.02</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>

      <!-- Door-knob grip: rosette + neck + round head (brass) -->
      <visual name="knob_rosette_visual">
        <pose>0 0 0.034 0 0 0</pose>
        <geometry><cylinder><radius>0.016</radius><length>0.004</length></cylinder></geometry>
        <material>
          <ambient>0.80 0.62 0.22 1.0</ambient>
          <diffuse>0.80 0.62 0.22 1.0</diffuse>
          <specular>0.9 0.8 0.5 1.0</specular>
        </material>
      </visual>
      <collision name="knob_rosette_collision">
        <pose>0 0 0.034 0 0 0</pose>
        <geometry><cylinder><radius>0.016</radius><length>0.004</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>

      <visual name="knob_neck_visual">
        <pose>0 0 0.042 0 0 0</pose>
        <geometry><cylinder><radius>0.006</radius><length>0.012</length></cylinder></geometry>
        <material>
          <ambient>0.80 0.62 0.22 1.0</ambient>
          <diffuse>0.80 0.62 0.22 1.0</diffuse>
          <specular>0.9 0.8 0.5 1.0</specular>
        </material>
      </visual>
      <collision name="knob_neck_collision">
        <pose>0 0 0.042 0 0 0</pose>
        <geometry><cylinder><radius>0.006</radius><length>0.012</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>

      <visual name="knob_head_visual">
        <pose>0 0 0.048 0 0 0</pose>
        <geometry><sphere><radius>0.014</radius></sphere></geometry>
        <material>
          <ambient>0.80 0.62 0.22 1.0</ambient>
          <diffuse>0.80 0.62 0.22 1.0</diffuse>
          <specular>0.9 0.8 0.5 1.0</specular>
        </material>
      </visual>
      <collision name="knob_head_collision">
        <pose>0 0 0.048 0 0 0</pose>
        <geometry><sphere><radius>0.014</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>
  </model>
</sdf>
