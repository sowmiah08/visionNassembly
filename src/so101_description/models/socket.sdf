<?xml version="1.0"?>
<!--
  Socket: a 60 x 60 x 25 mm block with four blind holes for the plug's pins
  (mesh made by meshes/generate_socket_cell.py). Static. Origin at the
  bottom face centre.
-->
<sdf version="1.9">
  <model name="socket">
    <!-- Ground-truth segmentation label (see segmentation_camera in
         dual_arm_workcell_gazebo.urdf.xacro). Unique per object type. -->
    <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
      <label>2</label>
    </plugin>
    <static>true</static>
    <link name="socket_link">
      <inertial>
        <pose>0 0 0.0125 0 0 0</pose>
        <mass>0.08</mass>
        <inertia>
          <ixx>2e-5</ixx>
          <iyy>2e-5</iyy>
          <izz>3e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- 4 quarter-cells tiled at the (+-0.015, +-0.015) quadrant offsets -->
      <visual name="cell_pp_visual">
        <pose>0.015 0.015 0 0 0 0</pose>
        <geometry>
          <mesh><uri>package://so101_description/meshes/socket_cell_blind_hole.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.62 0.30 0.06 1.0</ambient>
          <diffuse>0.62 0.30 0.06 1.0</diffuse>
          <specular>0.5 0.5 0.5 1.0</specular>
        </material>
      </visual>
      <collision name="cell_pp_collision">
        <pose>0.015 0.015 0 0 0 0</pose>
        <geometry>
          <mesh><uri>package://so101_description/meshes/socket_cell_blind_hole.stl</uri></mesh>
        </geometry>
      </collision>

      <visual name="cell_pn_visual">
        <pose>0.015 -0.015 0 0 0 0</pose>
        <geometry>
          <mesh><uri>package://so101_description/meshes/socket_cell_blind_hole.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.62 0.30 0.06 1.0</ambient>
          <diffuse>0.62 0.30 0.06 1.0</diffuse>
          <specular>0.5 0.5 0.5 1.0</specular>
        </material>
      </visual>
      <collision name="cell_pn_collision">
        <pose>0.015 -0.015 0 0 0 0</pose>
        <geometry>
          <mesh><uri>package://so101_description/meshes/socket_cell_blind_hole.stl</uri></mesh>
        </geometry>
      </collision>

      <visual name="cell_np_visual">
        <pose>-0.015 0.015 0 0 0 0</pose>
        <geometry>
          <mesh><uri>package://so101_description/meshes/socket_cell_blind_hole.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.62 0.30 0.06 1.0</ambient>
          <diffuse>0.62 0.30 0.06 1.0</diffuse>
          <specular>0.5 0.5 0.5 1.0</specular>
        </material>
      </visual>
      <collision name="cell_np_collision">
        <pose>-0.015 0.015 0 0 0 0</pose>
        <geometry>
          <mesh><uri>package://so101_description/meshes/socket_cell_blind_hole.stl</uri></mesh>
        </geometry>
      </collision>

      <visual name="cell_nn_visual">
        <pose>-0.015 -0.015 0 0 0 0</pose>
        <geometry>
          <mesh><uri>package://so101_description/meshes/socket_cell_blind_hole.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.62 0.30 0.06 1.0</ambient>
          <diffuse>0.62 0.30 0.06 1.0</diffuse>
          <specular>0.5 0.5 0.5 1.0</specular>
        </material>
      </visual>
      <collision name="cell_nn_collision">
        <pose>-0.015 -0.015 0 0 0 0</pose>
        <geometry>
          <mesh><uri>package://so101_description/meshes/socket_cell_blind_hole.stl</uri></mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
