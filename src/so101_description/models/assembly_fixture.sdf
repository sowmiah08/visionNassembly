<?xml version="1.0"?>
<!--
  Standalone assembly-fixture model (peghole workcell only): spawned
  separately from the robot URDF, rather than welded into it with a fixed
  joint, so its world position can be changed by editing the spawn
  `-x`/`-y`/`-z` args in the launch file -- no xacro edit or colcon rebuild
  needed to reposition it.

  <static>true</static>: it's a fixture that locates the base plate, not a
  pickable part.

  Geometry matches the `assembly_fixture` xacro macro in
  assembly_objects.urdf.xacro (default params): a shallow rimmed platform
  (floor 0.12 x 0.09 x 0.006 m + a 0.01 m-high, 0.004 m-thick perimeter
  lip), built from 5 primitive boxes. Link origin is at the floor's bottom
  face center -- the base_plate model sits on top of it (see base_plate
  .sdf and the spawn pose comment in the launch file).

  Mass/inertia here are a placeholder (not present in the original xacro
  macro either, since a static fixed-joint child doesn't need real values)
  -- inert either way since the model is static.
-->
<sdf version="1.9">
  <model name="assembly_fixture">
    <static>true</static>
    <link name="assembly_fixture_link">
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>1e-4</ixx>
          <iyy>1e-4</iyy>
          <izz>1e-4</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- floor -->
      <visual name="floor_visual">
        <pose>0 0 0.003 0 0 0</pose>
        <geometry><box><size>0.12 0.09 0.006</size></box></geometry>
        <material>
          <ambient>0.12 0.12 0.13 1.0</ambient>
          <diffuse>0.12 0.12 0.13 1.0</diffuse>
        </material>
      </visual>
      <collision name="floor_collision">
        <pose>0 0 0.003 0 0 0</pose>
        <geometry><box><size>0.12 0.09 0.006</size></box></geometry>
      </collision>

      <!-- +x rim wall -->
      <visual name="wall_px_visual">
        <pose>0.058 0 0.011 0 0 0</pose>
        <geometry><box><size>0.004 0.09 0.01</size></box></geometry>
        <material>
          <ambient>0.12 0.12 0.13 1.0</ambient>
          <diffuse>0.12 0.12 0.13 1.0</diffuse>
        </material>
      </visual>
      <collision name="wall_px_collision">
        <pose>0.058 0 0.011 0 0 0</pose>
        <geometry><box><size>0.004 0.09 0.01</size></box></geometry>
      </collision>

      <!-- -x rim wall -->
      <visual name="wall_nx_visual">
        <pose>-0.058 0 0.011 0 0 0</pose>
        <geometry><box><size>0.004 0.09 0.01</size></box></geometry>
        <material>
          <ambient>0.12 0.12 0.13 1.0</ambient>
          <diffuse>0.12 0.12 0.13 1.0</diffuse>
        </material>
      </visual>
      <collision name="wall_nx_collision">
        <pose>-0.058 0 0.011 0 0 0</pose>
        <geometry><box><size>0.004 0.09 0.01</size></box></geometry>
      </collision>

      <!-- +y rim wall -->
      <visual name="wall_py_visual">
        <pose>0 0.043 0.011 0 0 0</pose>
        <geometry><box><size>0.12 0.004 0.01</size></box></geometry>
        <material>
          <ambient>0.12 0.12 0.13 1.0</ambient>
          <diffuse>0.12 0.12 0.13 1.0</diffuse>
        </material>
      </visual>
      <collision name="wall_py_collision">
        <pose>0 0.043 0.011 0 0 0</pose>
        <geometry><box><size>0.12 0.004 0.01</size></box></geometry>
      </collision>

      <!-- -y rim wall -->
      <visual name="wall_ny_visual">
        <pose>0 -0.043 0.011 0 0 0</pose>
        <geometry><box><size>0.12 0.004 0.01</size></box></geometry>
        <material>
          <ambient>0.12 0.12 0.13 1.0</ambient>
          <diffuse>0.12 0.12 0.13 1.0</diffuse>
        </material>
      </visual>
      <collision name="wall_ny_collision">
        <pose>0 -0.043 0.011 0 0 0</pose>
        <geometry><box><size>0.12 0.004 0.01</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
