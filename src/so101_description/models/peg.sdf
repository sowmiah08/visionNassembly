<?xml version="1.0"?>
<!--
  Peg: a free body the gripper can pick up. Solid PLA cylinder, radius 9 mm,
  length 50 mm (mass 0.0158 kg). Origin at the bottom face centre.
  Friction 1.0 so it doesn't slip in the gripper.
-->
<sdf version="1.9">
  <model name="peg">
    <!-- Ground-truth label for the segmentation camera. Unique per object type. -->
    <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
      <label>3</label>
    </plugin>
    <link name="peg_link">
      <inertial>
        <pose>0 0 0.025 0 0 0</pose>
        <mass>0.01578</mass>
        <inertia>
          <ixx>3.6064e-06</ixx>
          <iyy>3.6064e-06</iyy>
          <izz>6.3897e-07</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="visual">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.57 0.60 1.0</ambient>
          <diffuse>0.55 0.57 0.60 1.0</diffuse>
          <specular>0.6 0.6 0.6 1.0</specular>
        </material>
      </visual>

      <collision name="collision">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
