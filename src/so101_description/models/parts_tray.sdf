<?xml version="1.0"?>
<!--
  Standalone parts-tray model (peghole workcell only): spawned separately
  from the robot URDF, rather than welded into it with a fixed joint, so
  its world position can be changed by editing the spawn `-x`/`-y`/`-z`
  args in the launch file -- no xacro edit or colcon rebuild needed to
  reposition it.

  <static>true</static>: it's a fixture holding the (decorative) spare
  pegs, not a pickable part itself.

  Geometry matches the `parts_tray` xacro macro in
  assembly_objects.urdf.xacro (default params): an open tray (floor 0.14 x
  0.10 x 0.004 m + a 0.03 m-high, 0.004 m-thick perimeter wall), built from
  5 primitive boxes, same construction as assembly_fixture.sdf but deeper.
  Link origin is at the floor's bottom face center -- the spare_peg models
  sit inside it (see spare_peg.sdf and the spawn pose comments in the
  launch file).

  Mass/inertia here are a placeholder (not present in the original xacro
  macro either) -- inert either way since the model is static.
-->
<sdf version="1.9">
  <model name="parts_tray">
    <static>true</static>
    <link name="parts_tray_link">
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>1e-4</ixx>
          <iyy>1e-4</iyy>
          <izz>1e-4</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- floor -->
      <visual name="floor_visual">
        <pose>0 0 0.002 0 0 0</pose>
        <geometry><box><size>0.14 0.10 0.004</size></box></geometry>
        <material>
          <ambient>0.15 0.35 0.65 1.0</ambient>
          <diffuse>0.15 0.35 0.65 1.0</diffuse>
        </material>
      </visual>
      <collision name="floor_collision">
        <pose>0 0 0.002 0 0 0</pose>
        <geometry><box><size>0.14 0.10 0.004</size></box></geometry>
      </collision>

      <!-- +x wall -->
      <visual name="wall_px_visual">
        <pose>0.068 0 0.015 0 0 0</pose>
        <geometry><box><size>0.004 0.10 0.03</size></box></geometry>
        <material>
          <ambient>0.15 0.35 0.65 1.0</ambient>
          <diffuse>0.15 0.35 0.65 1.0</diffuse>
        </material>
      </visual>
      <collision name="wall_px_collision">
        <pose>0.068 0 0.015 0 0 0</pose>
        <geometry><box><size>0.004 0.10 0.03</size></box></geometry>
      </collision>

      <!-- -x wall -->
      <visual name="wall_nx_visual">
        <pose>-0.068 0 0.015 0 0 0</pose>
        <geometry><box><size>0.004 0.10 0.03</size></box></geometry>
        <material>
          <ambient>0.15 0.35 0.65 1.0</ambient>
          <diffuse>0.15 0.35 0.65 1.0</diffuse>
        </material>
      </visual>
      <collision name="wall_nx_collision">
        <pose>-0.068 0 0.015 0 0 0</pose>
        <geometry><box><size>0.004 0.10 0.03</size></box></geometry>
      </collision>

      <!-- +y wall -->
      <visual name="wall_py_visual">
        <pose>0 0.048 0.015 0 0 0</pose>
        <geometry><box><size>0.14 0.004 0.03</size></box></geometry>
        <material>
          <ambient>0.15 0.35 0.65 1.0</ambient>
          <diffuse>0.15 0.35 0.65 1.0</diffuse>
        </material>
      </visual>
      <collision name="wall_py_collision">
        <pose>0 0.048 0.015 0 0 0</pose>
        <geometry><box><size>0.14 0.004 0.03</size></box></geometry>
      </collision>

      <!-- -y wall -->
      <visual name="wall_ny_visual">
        <pose>0 -0.048 0.015 0 0 0</pose>
        <geometry><box><size>0.14 0.004 0.03</size></box></geometry>
        <material>
          <ambient>0.15 0.35 0.65 1.0</ambient>
          <diffuse>0.15 0.35 0.65 1.0</diffuse>
        </material>
      </visual>
      <collision name="wall_ny_collision">
        <pose>0 -0.048 0.015 0 0 0</pose>
        <geometry><box><size>0.14 0.004 0.03</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
