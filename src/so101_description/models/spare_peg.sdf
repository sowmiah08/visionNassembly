<?xml version="1.0"?>
<!--
  Spare peg (peghole workcell only): a small static peg, radius 7 mm, 35 mm
  long, shown lying in the parts tray. Spawned twice with different names.
-->
<sdf version="1.9">
  <model name="spare_peg">
    <static>true</static>
    <link name="spare_peg_link">
      <inertial>
        <pose>0 0 0.0175 0 0 0</pose>
        <mass>0.02</mass>
        <inertia>
          <ixx>1e-6</ixx>
          <iyy>1e-6</iyy>
          <izz>1e-6</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="visual">
        <pose>0 0 0.0175 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.007</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.57 0.60 1.0</ambient>
          <diffuse>0.55 0.57 0.60 1.0</diffuse>
          <specular>0.6 0.6 0.6 1.0</specular>
        </material>
      </visual>
      <collision name="collision">
        <pose>0 0 0.0175 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.007</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
