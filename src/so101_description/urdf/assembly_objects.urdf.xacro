<?xml version="1.0"?>
<!--
  Modular assembly-task object library for the dual-arm workcell.

  Each macro instantiates one self-contained link (plus the fixed joint that
  attaches it to a parent link) so new assembly objects can be added later
  without touching the existing ones. Include this file once, then call the
  macros as many times as needed.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="plate_aluminum">
    <color rgba="0.75 0.75 0.78 1.0"/>
  </material>

  <material name="peg_steel">
    <color rgba="0.55 0.57 0.60 1.0"/>
  </material>

  <material name="fixture_black">
    <color rgba="0.12 0.12 0.13 1.0"/>
  </material>

  <material name="tray_blue">
    <color rgba="0.15 0.35 0.65 1.0"/>
  </material>

  <!-- ================= PEG ================= -->
  <!-- Cylindrical peg. Link origin is at the bottom face center, so placing
       the parent joint's xyz at a surface point rests the peg on it. -->
  <xacro:macro name="peg" params="name parent xyz rpy radius:=0.009 length:=0.05 material:=peg_steel">
    <link name="${name}_link">
      <inertial>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <mass value="0.02"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
      <visual>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${parent}_to_${name}" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- ================= BASE PLATE WITH HOLE ================= -->
  <!-- Rectangular plate with a genuine cylindrical hole (real mesh geometry,
       generated by meshes/generate_plate_with_hole.py: 0.10 x 0.07 x 0.006 m,
       0.012 m hole radius). Link origin is at the bottom face center. The
       same mesh is used for collision; this is fine because the plate is
       mounted via a fixed joint (static), so a concave collision mesh does
       not need convex decomposition for stable physics. -->
  <xacro:macro name="base_plate_with_hole" params="name parent xyz rpy">
    <link name="${name}_link">
      <inertial>
        <origin xyz="0 0 0.003" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="5e-6" ixy="0" ixz="0" iyy="5e-6" iyz="0" izz="1e-5"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://so101_description/meshes/base_plate_with_hole.stl"/>
        </geometry>
        <material name="plate_aluminum"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://so101_description/meshes/base_plate_with_hole.stl"/>
        </geometry>
      </collision>
    </link>

    <joint name="${parent}_to_${name}" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- ================= ASSEMBLY FIXTURE ================= -->
  <!-- Shallow rimmed platform that locates the base plate and stops it
       sliding: a floor plus a thin perimeter lip, built from primitive
       boxes (5-box "tray" construction). Sized with a small margin over
       the base plate's 0.10 x 0.07 m footprint. -->
  <xacro:macro name="assembly_fixture" params="name parent xyz rpy
                floor_x:=0.12 floor_y:=0.09 floor_z:=0.006
                wall_h:=0.01 wall_t:=0.004">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 ${floor_z/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${floor_x} ${floor_y} ${floor_z}"/>
        </geometry>
        <material name="fixture_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${floor_z/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${floor_x} ${floor_y} ${floor_z}"/>
        </geometry>
      </collision>

      <!-- +x / -x rim walls -->
      <visual>
        <origin xyz="${floor_x/2 - wall_t/2} 0 ${floor_z + wall_h/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${wall_t} ${floor_y} ${wall_h}"/>
        </geometry>
        <material name="fixture_black"/>
      </visual>
      <collision>
        <origin xyz="${floor_x/2 - wall_t/2} 0 ${floor_z + wall_h/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${wall_t} ${floor_y} ${wall_h}"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="${-floor_x/2 + wall_t/2} 0 ${floor_z + wall_h/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${wall_t} ${floor_y} ${wall_h}"/>
        </geometry>
        <material name="fixture_black"/>
      </visual>
      <collision>
        <origin xyz="${-floor_x/2 + wall_t/2} 0 ${floor_z + wall_h/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${wall_t} ${floor_y} ${wall_h}"/>
        </geometry>
      </collision>

      <!-- +y / -y rim walls -->
      <visual>
        <origin xyz="0 ${floor_y/2 - wall_t/2} ${floor_z + wall_h/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${floor_x} ${wall_t} ${wall_h}"/>
        </geometry>
        <material name="fixture_black"/>
      </visual>
      <collision>
        <origin xyz="0 ${floor_y/2 - wall_t/2} ${floor_z + wall_h/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${floor_x} ${wall_t} ${wall_h}"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 ${-floor_y/2 + wall_t/2} ${floor_z + wall_h/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${floor_x} ${wall_t} ${wall_h}"/>
        </geometry>
        <material name="fixture_black"/>
      </visual>
      <collision>
        <origin xyz="0 ${-floor_y/2 + wall_t/2} ${floor_z + wall_h/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${floor_x} ${wall_t} ${wall_h}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${parent}_to_${name}" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- ================= PARTS TRAY ================= -->
  <!-- Small open tray for unassembled components, built the same way as
       assembly_fixture (5-box construction) but deeper. -->
  <xacro:macro name="parts_tray" params="name parent xyz rpy
                tray_x:=0.14 tray_y:=0.10 tray_z:=0.03 wall_t:=0.004">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 ${wall_t/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${tray_x} ${tray_y} ${wall_t}"/>
        </geometry>
        <material name="tray_blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${wall_t/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${tray_x} ${tray_y} ${wall_t}"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="${tray_x/2 - wall_t/2} 0 ${tray_z/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${wall_t} ${tray_y} ${tray_z}"/>
        </geometry>
        <material name="tray_blue"/>
      </visual>
      <collision>
        <origin xyz="${tray_x/2 - wall_t/2} 0 ${tray_z/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${wall_t} ${tray_y} ${tray_z}"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="${-tray_x/2 + wall_t/2} 0 ${tray_z/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${wall_t} ${tray_y} ${tray_z}"/>
        </geometry>
        <material name="tray_blue"/>
      </visual>
      <collision>
        <origin xyz="${-tray_x/2 + wall_t/2} 0 ${tray_z/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${wall_t} ${tray_y} ${tray_z}"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 ${tray_y/2 - wall_t/2} ${tray_z/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${tray_x} ${wall_t} ${tray_z}"/>
        </geometry>
        <material name="tray_blue"/>
      </visual>
      <collision>
        <origin xyz="0 ${tray_y/2 - wall_t/2} ${tray_z/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${tray_x} ${wall_t} ${tray_z}"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 ${-tray_y/2 + wall_t/2} ${tray_z/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${tray_x} ${wall_t} ${tray_z}"/>
        </geometry>
        <material name="tray_blue"/>
      </visual>
      <collision>
        <origin xyz="0 ${-tray_y/2 + wall_t/2} ${tray_z/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${tray_x} ${wall_t} ${tray_z}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${parent}_to_${name}" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

</robot>
