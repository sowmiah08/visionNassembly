<?xml version="1.0"?>
<!--
  Dual-arm assembly workcell (Gazebo Harmonic variant): same table, arms,
  overhead camera and assembly objects as dual_arm_workcell_peghole.urdf.xacro,
  plus ros2_control command/state interfaces and the gz_ros2_control plugin
  so it can be spawned into Gazebo (mirrors the existing
  dual_arm_gazebo.urdf.xacro pattern).

  The assembly fixture, base plate, socket, and parts tray (with its two
  decorative spare pegs) are all static, fixed to the table here. The
  functional peg and 4-pin plug are instead genuine free rigid bodies,
  spawned separately as models/peg.sdf and models/plug.sdf by
  workcell_peghole_gazebo.launch.py so they can actually be picked up, with
  their ground-truth poses bridged to ROS 2 for later perception evaluation.

  The wrist cameras are mounted physically (mesh + link + joint, via the
  so101_*_arm_camera fragments) but intentionally have no gazebo sensor
  block yet; only the already-existing overhead camera is wired up as a
  sensor, to avoid building out a sensor pipeline that hasn't been asked for.
-->
<robot name="so101_dual_arm_workcell" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Wrist-camera-equipped, already-prefixed arm fragments -->
  <xacro:include filename="$(find so101_description)/urdf/so101_left_arm_camera.urdf.fragment"/>
  <xacro:include filename="$(find so101_description)/urdf/so101_right_arm_camera.urdf.fragment"/>

  <!-- Modular assembly-task object macros (peg, base plate w/ hole, fixture, tray) -->
  <xacro:include filename="$(find so101_description)/urdf/assembly_objects.urdf.xacro"/>

  <!-- ================= TABLE (industrial aluminum-extrusion bench) ================= -->
  <!-- x = long side = 100 cm -->
  <!-- y = short side = 50 cm -->
  <xacro:property name="table_x"     value="1.0"/>
  <xacro:property name="table_y"     value="0.5"/>
  <xacro:property name="table_thick" value="0.03"/>
  <xacro:property name="trim_thick"  value="0.006"/>
  <xacro:property name="table_top_z" value="0.76"/>

  <xacro:property name="leg_size"    value="0.035"/>
  <xacro:property name="leg_inset"   value="0.04"/>
  <xacro:property name="leg_length"  value="${table_top_z - table_thick - trim_thick}"/>

  <xacro:property name="rail_size"         value="0.03"/>
  <xacro:property name="rail_height"       value="0.12"/>
  <xacro:property name="lower_shelf_thick" value="0.012"/>

  <!-- ================= ROBOTS =================== -->
  <xacro:property name="robot_y"       value="${table_y/2}"/>
  <xacro:property name="robot_left_x"  value="-0.25"/>
  <xacro:property name="robot_right_x" value="0.25"/>
  <xacro:property name="robot_yaw"     value="${-pi/2}"/>

  <!-- ================= OVERHEAD CAMERA GANTRY ================= -->
  <xacro:property name="gantry_post_size"   value="0.04"/>
  <xacro:property name="gantry_post_height" value="0.55"/>
  <xacro:property name="gantry_post_x"      value="0.46"/>

  <!-- pitch=85deg: 5deg off straight-down (was 60deg/30deg) -->
  <xacro:property name="cam_pitch" value="${pi*85/180}"/>
  <xacro:property name="cam_yaw"   value="${-pi/2}"/>

  <!-- ================= ASSEMBLY AREA ================= -->
  <xacro:property name="fixture_x" value="0.0"/>
  <xacro:property name="fixture_y" value="0.08"/>
  <xacro:property name="tray_x"    value="-0.17"/>
  <xacro:property name="tray_y"    value="0.08"/>

  <!-- 4-pin plug/socket pair, clear of the fixture/tray/peg above and well
       short of the right arm base (x=0.25) -->
  <xacro:property name="socket_x" value="0.18"/>
  <xacro:property name="socket_y" value="0.08"/>
  <xacro:property name="plug_x"   value="0.18"/>
  <xacro:property name="plug_y"   value="0.16"/>

  <!-- ================= MATERIALS ================= -->
  <material name="bench_top_dark">
    <color rgba="0.14 0.14 0.15 1.0"/>
  </material>

  <material name="aluminum_frame">
    <color rgba="0.72 0.72 0.74 1.0"/>
  </material>

  <material name="camera_black">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>

  <material name="3d_printed">
    <color rgba="1.0 0.82 0.12 1.0"/>
  </material>

  <material name="sts3215">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- ================= WORLD ================= -->
  <link name="world"/>

  <!-- ================= TABLETOP ================= -->
  <link name="table_link">
    <visual>
      <origin xyz="0 0 ${-table_thick/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${table_x} ${table_y} ${table_thick}"/>
      </geometry>
      <material name="bench_top_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${-table_thick/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${table_x} ${table_y} ${table_thick}"/>
      </geometry>
    </collision>

    <!-- Brushed-aluminum edge trim -->
    <visual>
      <origin xyz="0 0 ${-table_thick - trim_thick/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${table_x + 0.01} ${table_y + 0.01} ${trim_thick}"/>
      </geometry>
      <material name="aluminum_frame"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${-table_thick - trim_thick/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${table_x + 0.01} ${table_y + 0.01} ${trim_thick}"/>
      </geometry>
    </collision>
  </link>

  <joint name="world_to_table" type="fixed">
    <parent link="world"/>
    <child link="table_link"/>
    <origin xyz="0 0 ${table_top_z}" rpy="0 0 0"/>
  </joint>

  <!-- ================= EXTRUSION LEGS ================= -->
  <xacro:macro name="bench_leg" params="name x y">
    <link name="${name}">
      <visual>
        <geometry>
          <box size="${leg_size} ${leg_size} ${leg_length}"/>
        </geometry>
        <material name="aluminum_frame"/>
      </visual>
      <collision>
        <geometry>
          <box size="${leg_size} ${leg_size} ${leg_length}"/>
        </geometry>
      </collision>
    </link>

    <joint name="joint_${name}" type="fixed">
      <parent link="table_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${-(table_thick + trim_thick) - leg_length/2}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:bench_leg name="leg1" x="${table_x/2 - leg_inset}"  y="${table_y/2 - leg_inset}"/>
  <xacro:bench_leg name="leg2" x="${table_x/2 - leg_inset}"  y="${-table_y/2 + leg_inset}"/>
  <xacro:bench_leg name="leg3" x="${-table_x/2 + leg_inset}" y="${table_y/2 - leg_inset}"/>
  <xacro:bench_leg name="leg4" x="${-table_x/2 + leg_inset}" y="${-table_y/2 + leg_inset}"/>

  <!-- ================= LOWER RAIL FRAME ================= -->
  <xacro:property name="rail_z"      value="${-table_top_z + rail_height}"/>
  <xacro:property name="rail_span_x" value="${table_x - 2*leg_inset - leg_size}"/>
  <xacro:property name="rail_span_y" value="${table_y - 2*leg_inset - leg_size}"/>

  <xacro:macro name="bench_rail" params="name x y size_x size_y">
    <link name="${name}">
      <visual>
        <geometry>
          <box size="${size_x} ${size_y} ${rail_size}"/>
        </geometry>
        <material name="aluminum_frame"/>
      </visual>
      <collision>
        <geometry>
          <box size="${size_x} ${size_y} ${rail_size}"/>
        </geometry>
      </collision>
    </link>

    <joint name="joint_${name}" type="fixed">
      <parent link="table_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${rail_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:bench_rail name="rail_front" x="0" y="${table_y/2 - leg_inset}"  size_x="${rail_span_x}" size_y="${rail_size}"/>
  <xacro:bench_rail name="rail_back"  x="0" y="${-table_y/2 + leg_inset}" size_x="${rail_span_x}" size_y="${rail_size}"/>
  <xacro:bench_rail name="rail_left"  x="${-table_x/2 + leg_inset}" y="0" size_x="${rail_size}" size_y="${rail_span_y}"/>
  <xacro:bench_rail name="rail_right" x="${table_x/2 - leg_inset}"  y="0" size_x="${rail_size}" size_y="${rail_span_y}"/>

  <!-- ================= LOWER STORAGE SHELF ================= -->
  <link name="lower_shelf_link">
    <visual>
      <geometry>
        <box size="${rail_span_x} ${rail_span_y} ${lower_shelf_thick}"/>
      </geometry>
      <material name="bench_top_dark"/>
    </visual>
    <collision>
      <geometry>
        <box size="${rail_span_x} ${rail_span_y} ${lower_shelf_thick}"/>
      </geometry>
    </collision>
  </link>

  <joint name="table_to_lower_shelf" type="fixed">
    <parent link="table_link"/>
    <child link="lower_shelf_link"/>
    <origin xyz="0 0 ${rail_z + rail_size/2 + lower_shelf_thick/2}" rpy="0 0 0"/>
  </joint>

  <!-- ================= LEFT ARM ================= -->
  <joint name="table_to_left_robot" type="fixed">
    <parent link="table_link"/>
    <child link="left_base_link"/>
    <origin xyz="${robot_left_x} ${robot_y} 0" rpy="0 0 ${robot_yaw}"/>
  </joint>

  <!-- ================= RIGHT ARM ================= -->
  <joint name="table_to_right_robot" type="fixed">
    <parent link="table_link"/>
    <child link="right_base_link"/>
    <origin xyz="${robot_right_x} ${robot_y} 0" rpy="0 0 ${robot_yaw}"/>
  </joint>

  <!-- ================= OVERHEAD CAMERA GANTRY ================= -->
  <xacro:macro name="gantry_post" params="name x">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${gantry_post_height/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${gantry_post_size} ${gantry_post_size} ${gantry_post_height}"/>
        </geometry>
        <material name="aluminum_frame"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${gantry_post_height/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${gantry_post_size} ${gantry_post_size} ${gantry_post_height}"/>
        </geometry>
      </collision>
    </link>

    <joint name="table_to_${name}" type="fixed">
      <parent link="table_link"/>
      <child link="${name}"/>
      <origin xyz="${x} 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:gantry_post name="gantry_post_left"  x="${-gantry_post_x}"/>
  <xacro:gantry_post name="gantry_post_right" x="${gantry_post_x}"/>

  <link name="gantry_crossbar_link">
    <visual>
      <geometry>
        <box size="${2*gantry_post_x + gantry_post_size} ${gantry_post_size} ${gantry_post_size}"/>
      </geometry>
      <material name="aluminum_frame"/>
    </visual>
    <collision>
      <geometry>
        <box size="${2*gantry_post_x + gantry_post_size} ${gantry_post_size} ${gantry_post_size}"/>
      </geometry>
    </collision>
  </link>

  <joint name="post_to_crossbar" type="fixed">
    <parent link="gantry_post_left"/>
    <child link="gantry_crossbar_link"/>
    <origin xyz="${gantry_post_x} 0 ${gantry_post_height}" rpy="0 0 0"/>
  </joint>

  <!-- ================= CAMERA MOUNT BRACKET ================= -->
  <link name="camera_mount_link">
    <visual>
      <origin xyz="0 0 -0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.05"/>
      </geometry>
      <material name="aluminum_frame"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="crossbar_to_mount" type="fixed">
    <parent link="gantry_crossbar_link"/>
    <child link="camera_mount_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================= OVERHEAD CAMERA ================= -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
      <material name="camera_black"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="mount_to_camera" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 -0.05" rpy="0 ${cam_pitch} ${cam_yaw}"/>
  </joint>

  <!-- ================= OPTICAL FRAME ================= -->
  <link name="camera_optical_frame"/>

  <joint name="camera_to_optical" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- ================= ASSEMBLY FIXTURE + BASE PLATE (static) ================= -->
  <!-- The peg is NOT instantiated here: it's a free rigid body, spawned
       separately as models/peg.sdf via `ros2 run ros_gz_sim create` in
       workcell_peghole_gazebo.launch.py (at the same spot it used to
       occupy: x = fixture_x + 0.09, y = fixture_y) so it's actually
       pickable rather than welded to the table. -->
  <xacro:assembly_fixture name="assembly_fixture" parent="table_link"
    xyz="${fixture_x} ${fixture_y} 0" rpy="0 0 0"/>

  <xacro:base_plate_with_hole name="base_plate" parent="assembly_fixture_link"
    xyz="0 0 0.006" rpy="0 0 0"/>

  <!-- ================= PARTS TRAY ================= -->
  <!-- Spare pegs stay fixed/decorative: only the functional peg and plug
       were asked to become pickable, not every loose part in the scene. -->
  <xacro:parts_tray name="parts_tray" parent="table_link"
    xyz="${tray_x} ${tray_y} 0" rpy="0 0 0"/>

  <xacro:peg name="spare_peg_1" parent="parts_tray_link"
    xyz="-0.03 0.02 0.013" rpy="0 ${pi/2} 0" radius="0.007" length="0.035"/>

  <xacro:peg name="spare_peg_2" parent="parts_tray_link"
    xyz="0.02 -0.015 0.013" rpy="0 ${pi/2} ${pi/4}" radius="0.007" length="0.035"/>

  <!-- ================= SOCKET (static) ================= -->
  <!-- The plug is likewise spawned separately as models/plug.sdf, not
       instantiated here, see workcell_peghole_gazebo.launch.py. -->
  <xacro:socket name="socket" parent="table_link"
    xyz="${socket_x} ${socket_y} 0" rpy="0 0 0"/>

  <!-- ================= ROS2_CONTROL ================ -->
  <xacro:macro name="position_joint" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <xacro:position_joint name="left_shoulder_pan"/>
    <xacro:position_joint name="left_shoulder_lift"/>
    <xacro:position_joint name="left_elbow_flex"/>
    <xacro:position_joint name="left_wrist_flex"/>
    <xacro:position_joint name="left_wrist_roll"/>
    <xacro:position_joint name="left_gripper"/>

    <xacro:position_joint name="right_shoulder_pan"/>
    <xacro:position_joint name="right_shoulder_lift"/>
    <xacro:position_joint name="right_elbow_flex"/>
    <xacro:position_joint name="right_wrist_flex"/>
    <xacro:position_joint name="right_wrist_roll"/>
    <xacro:position_joint name="right_gripper"/>
  </ros2_control>

  <!-- ================= GAZEBO_PLUGINS ================ -->
  <gazebo reference="camera_link">
    <sensor name="rgb_camera" type="camera">
      <topic>overhead_camera/rgb/image_raw</topic>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.57</horizontal_fov>
        <image><width>640</width><height>480</height></image>
        <clip><near>0.05</near><far>5.0</far></clip>
      </camera>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>

    <sensor name="depth_camera" type="depth_camera">
      <topic>overhead_camera/depth/image_raw</topic>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.57</horizontal_fov>
        <image><width>640</width><height>480</height></image>
        <clip><near>0.1</near><far>5.0</far></clip>
      </camera>
      <always_on>1</always_on>
    </sensor>
  </gazebo>

  <!-- Wrist cameras: simple UVC RGB webcams (no depth, matching the real
       Hex-Nut 32x32 UVC module the mount is sized for). -->
  <gazebo reference="left_wrist_camera_link">
    <sensor name="left_wrist_rgb_camera" type="camera">
      <topic>left_wrist_camera/image_raw</topic>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.57</horizontal_fov>
        <image><width>640</width><height>480</height></image>
        <clip><near>0.02</near><far>3.0</far></clip>
      </camera>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="right_wrist_camera_link">
    <sensor name="right_wrist_rgb_camera" type="camera">
      <topic>right_wrist_camera/image_raw</topic>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.57</horizontal_fov>
        <image><width>640</width><height>480</height></image>
        <clip><near>0.02</near><far>3.0</far></clip>
      </camera>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find so101_description)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
